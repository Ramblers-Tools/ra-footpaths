<?xml version="1.0" encoding="utf-8"?>
<config>
	<fieldset name="component" label="COM_RA_FOOTPATHS_CONFIG_LABEL" description="COM_RA_FOOTPATHS_CONFIG_DESC">
		<field
			name="inspector_group"
			type="usergrouplist"
			label="COM_RA_FOOTPATHS_CONFIG_INSPECTOR_GROUP_LABEL"
			description="COM_RA_FOOTPATHS_CONFIG_INSPECTOR_GROUP_DESC"
			default=""
			>
			<option value="">COM_RA_FOOTPATHS_CONFIG_CHOOSE_GROUP</option>
		</field>
		<field
			name="manager_group"
			type="usergrouplist"
			label="COM_RA_FOOTPATHS_CONFIG_MANAGER_GROUP_LABEL"
			description="COM_RA_FOOTPATHS_CONFIG_MANAGER_GROUP_DESC"
			default=""
			>
			<option value="">COM_RA_FOOTPATHS_CONFIG_CHOOSE_GROUP</option>
		</field>
		<field
			name="photo_path"
			type="text"
			label="COM_RA_FOOTPATHS_CONFIG_PHOTO_PATH_LABEL"
			description="COM_RA_FOOTPATHS_CONFIG_PHOTO_PATH_DESC"
			default=""
			filter="path"
		/>
		<field
			name="recording"
			type="radio"
			label="COM_RA_FOOTPATHS_CONFIG_RECORDING_LABEL"
			description="COM_RA_FOOTPATHS_CONFIG_RECORDING_DESC"
			layout="joomla.form.field.radio.switcher"
			default="1"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="recording_off_message"
			type="textarea"
			label="COM_RA_FOOTPATHS_CONFIG_RECORDING_OFF_LABEL"
			description="COM_RA_FOOTPATHS_CONFIG_RECORDING_OFF_DESC"
			default=""
			rows="3"
			filter="string"
			showon="recording:0"
		/>
		<field
			name="readonly_note"
			type="textarea"
			label="COM_RA_FOOTPATHS_CONFIG_READONLY_NOTE_LABEL"
			description="COM_RA_FOOTPATHS_CONFIG_READONLY_NOTE_DESC"
			default=""
			rows="3"
			filter="string"
			showon="recording:0"
		/>
		<field
			name="report_logo"
			type="media"
			label="COM_RA_FOOTPATHS_CONFIG_REPORT_LOGO_LABEL"
			description="COM_RA_FOOTPATHS_CONFIG_REPORT_LOGO_DESC"
			default=""
			preview="tooltip"
		/>
		<field
			name="report_name"
			type="text"
			label="COM_RA_FOOTPATHS_CONFIG_REPORT_NAME_LABEL"
			description="COM_RA_FOOTPATHS_CONFIG_REPORT_NAME_DESC"
			default=""
			maxlength="100"
			filter="string"
		/>
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" component="com_ra_footpaths" section="component" />
	</fieldset>
</config>
