<?xml version="1.0" encoding="utf-8"?>
<!--
    18/11/26 RH version 0.1.0 - stage 1 read-only demo: legacy import, parish list, parish map, path history
    18/11/26 RH version 0.2.0 - parishes map / list, "My parishes" (inspector_users table), photo popup
    18/11/26 RH version 0.3.0 - record an inspection: trial form (nothing saved; popup shows what would be)
    18/11/26 RH version 0.4.0 - read-only JSON endpoints for the Ramblers Tools app (task=app.*, needs com_ra_tools 4.4.0)
    19/11/26 RH version 0.5.0 - Inspectors (admin, and on the website for the Footpath admins group): link logins, parishes, new inspectors
    19/11/26 RH version 0.6.0 - Stage 2: inspections saved for real (faults, photos), changed or deleted; follow-up notes; change log
    19/11/26 RH version 0.7.0 - Inspector contact details (email, phone, membership no.) for footpath admins; CSV export; match logins by email
    19/11/26 RH version 0.8.0 - Reports: the old system's nine reports, filtered by period, parish and fault type; print/PDF and CSV; report logo and name in Options
    19/11/26 RH version 0.9.0 - Option "Recording on the website" (off: read only for everyone, with a message for inspectors)
-->
<extension type="component" version="4.0" method="upgrade">
    <name>COM_RA_FOOTPATHS</name>
    <element>com_ra_footpaths</element>
    <creationDate>19 Nov 2026</creationDate>
    <copyright>Copyright (C) 2026 East Cheshire Ramblers. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <author>Richard Higham</author>
    <authorUrl>https://ramblerseastcheshire.org.uk</authorUrl>
    <version>0.9.0</version>
    <description>COM_RA_FOOTPATHS_XML_DESCRIPTION</description>
    <namespace path="src">Ramblers\Component\Ra_footpaths</namespace>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>

    <files folder="site">
        <folder>language</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>
    <languages folder="site/language">
        <language tag="en-GB">en-GB/com_ra_footpaths.ini</language>
    </languages>

    <media folder="media" destination="com_ra_footpaths">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>js</folder>
    </media>

    <administration>
        <menu link="option=com_ra_footpaths">COM_RA_FOOTPATHS</menu>
        <submenu>
            <menu link="option=com_ra_footpaths&amp;view=dashboard">COM_RA_FOOTPATHS_MENU_DASHBOARD</menu>
            <menu link="option=com_ra_footpaths&amp;view=inspectors">COM_RA_FOOTPATHS_MENU_INSPECTORS</menu>
        </submenu>
        <files folder="administrator">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <folder>language</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
        </files>
        <languages folder="administrator/language">
            <language tag="en-GB">en-GB/com_ra_footpaths.ini</language>
            <language tag="en-GB">en-GB/com_ra_footpaths.sys.ini</language>
        </languages>
    </administration>
</extension>
